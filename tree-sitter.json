{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cpp",
      "camelcase": "CPP",
      "scope": "source.cpp",
      "path": ".",
      "file-types": ["cc", "cpp", "cxx", "hpp", "hxx", "h"],
      "highlights": ["c/queries/highlights.scm", "queries/highlights.scm"],
      "injections": "queries/injections.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^(cc|cpp)$"
    }
  ],
  "metadata": {
    "version": "0.23.4",
    "license": "MIT",
    "description": "C++ grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-cpp"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
