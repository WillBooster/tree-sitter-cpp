{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cpp",
      "camelcase": "CPP",
      "scope": "source.cpp",
      "path": ".",
      "file-types": ["cc", "cpp", "cxx", "hpp", "hxx", "h"],
      "injection-regex": "^(cc|cpp)$",
      "external-files": [
        "src/pragma.h",
        "src/identifier.h",
        "src/keywords.h",
        "src/functionMacro.h",
        "src/conditionalMacro.h",
        "src/initializerConditional.h"
      ]
    }
  ],
  "metadata": {
    "version": "0.23.4",
    "license": "MIT",
    "description": "C++ grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-cpp"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
