{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>WillBooster/willbooster-configs:renovate.jsonc"],
  "packageRules": [
    {
      // The Wasm build that tree-sitter-cli emits must load in @willbooster/web-tree-sitter, so they are updated
      // and tested together.
      "matchPackageNames": ["tree-sitter-cli", "@willbooster/web-tree-sitter"],
      "groupName": "tree-sitter",
    },
    {
      // grammar.js extends @willbooster/tree-sitter-c, so a bump changes the generated parser and needs a
      // regenerated src/, which Renovate cannot produce.
      "matchPackageNames": ["@willbooster/tree-sitter-c"],
      "enabled": false,
    },
  ],
}
